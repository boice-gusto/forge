{
  "name": "forge-workspace",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Forge AI workflow platform monorepo (Phase 0 \u2014 specification)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "docs:list": "ls -1 docs/*.md",
    "lint": "biome check .",
    "measure:phase1": "tsx scripts/measure-phase1.ts",
    "security:licenses": "tsx scripts/check-licenses.ts",
    "security:secrets": "tsx scripts/check-secrets.ts",
    "test": "vitest run",
    "test:architecture": "vitest run tooling/architecture.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:packaging": "tsx scripts/check-packaging.ts",
    "test:security": "vitest run packages/composition/src/gate-bypass.test.ts",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.16",
    "@types/node": "^25.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.1.0",
    "tsx": "^4.23.4",
    "turbo": "^2.7.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
