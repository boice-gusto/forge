{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": [
    "DOCKER_HOST",
    "FORGE_REQUIRE_STORES",
    "FORGE_SCAN_ROOTS",
    "TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE"
  ]
}
